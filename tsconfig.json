{
  "compilerOptions": {
    "allowJs": true,
    "baseUrl": ".",
    "paths": { "@/*": ["./src/*"] },
    "target": "ES6",
    "module": "CommonJS",
    "lib": ["ESNext", "DOM"],
    "skipLibCheck": true,
    "moduleResolution": "node",
    "esModuleInterop": true
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts", "src/**/*.tsx", "src/**/*.vue"]
}
